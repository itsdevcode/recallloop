APP_NAME=RecallLoop API
APP_ENV=development
# Required for database operations and Alembic; liveness works without a database.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recallloop
# Comma-separated origins, without trailing slashes.
CORS_ORIGINS=http://localhost:3000

# Generate a secret: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Uncomment after generating; never commit the real value.
# JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
FRONTEND_ORIGIN=http://localhost:3000
AUTH_COOKIE_NAME=recallloop_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
# Tests require a separate database whose name ends in _test.
# TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recallloop_test

# Google AI Studio key. Only the server/worker reads this; never use NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
CELERY_BROKER_URL=redis://localhost:6379/0
# Persisted create/retry submissions per user per rolling 24-hour window.
PROCESSING_REQUESTS_PER_DAY=10
# Browser tests require a separate local broker database (never database 0).
# TEST_CELERY_BROKER_URL=redis://127.0.0.1:56379/13
